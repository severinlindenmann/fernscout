# The same machine, one release later — or the same machine before B01 was
# applied by hand. The block is there, the site works, and `header_up
# X-Forwarded-For` is not in it, so Caddy appends the header instead of
# overwriting it and every rate limit on the server can be reset by forging
# one. A deploy reported this machine healthy for a day.
{
	email ops@example.invalid
}

other.example {
	# A neighbour, kept deliberately path-free: `file_server` records the
	# config file's own absolute path in its `hide` list, which would put this
	# checkout's directory into a committed fixture.
	respond "the other site, and this deploy did not touch it"
}

journal.example {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3000
}
