{
  "apps": {
    "http": {
      "servers": {
        "srv0": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "fernscout.invalid"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "request_body",
                          "max_size": 545259520
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/api/v1/*/trips/*/media",
                            "/api/v1/*/inbox",
                            "/api/helper/*/inbox",
                            "/api/helper/*/day/media",
                            "/api/v1/*/import",
                            "/api/v1/*/trips/*/travellers/from-photo"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "request_body",
                          "max_size": 25000000
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/api/helper/*/transcribe"
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "handler": "request_body",
                          "max_size": 10000000
                        }
                      ],
                      "match": [
                        {
                          "not": [
                            {
                              "path": [
                                "/api/v1/*/trips/*/media",
                                "/api/v1/*/inbox",
                                "/api/helper/*/inbox",
                                "/api/helper/*/day/media",
                                "/api/v1/*/import",
                                "/api/v1/*/trips/*/travellers/from-photo",
                                "/api/helper/*/transcribe"
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "handle": [
                        {
                          "encodings": {
                            "gzip": {},
                            "zstd": {}
                          },
                          "handler": "encode",
                          "prefer": [
                            "gzip",
                            "zstd"
                          ]
                        }
                      ]
                    },
                    {
                      "group": "group2",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "static_response",
                                  "status_code": 405
                                }
                              ]
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "method": [
                            "TRACE",
                            "TRACK"
                          ]
                        }
                      ]
                    },
                    {
                      "group": "group2",
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "reverse_proxy",
                                  "headers": {
                                    "request": {
                                      "set": {
                                        "X-Forwarded-For": [
                                          "{http.request.remote.host}"
                                        ]
                                      }
                                    }
                                  },
                                  "upstreams": [
                                    {
                                      "dial": "127.0.0.1:3000"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
