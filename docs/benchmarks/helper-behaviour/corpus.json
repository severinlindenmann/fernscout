{
  "note": "Scenarios for `npm run helper:bench` \u2014 B1744. Every one of these is a situation somebody was really in; the `why` names the ticket. Add a scenario when a conversation fails in front of a person, before arguing about the prompt that caused it. An expectation must name the failure, not a word near it: `answerHasNot` matched a sentence that merely stated the address it was using, and scored a correct answer as wrong.",
  "scenarios": [
    {
      "id": "card-to-trip-named",
      "why": "B1737. A contact card is in the inbox and ticked, and the person says plainly what to do with it. The address is on the card; asking for it is the failure.",
      "channel": "web",
      "world": {
        "locale": "de",
        "trips": [
          {
            "id": "ungarn-2026",
            "title": "Ungarn 2026",
            "start": "2026-06-01",
            "end": "2026-06-14"
          }
        ],
        "contacts": [
          {
            "name": "Viktoria Zentai",
            "email": "viktoria@example.test"
          }
        ],
        "select": "Viktoria Zentai"
      },
      "turns": [
        "setze Viktoria auf die Namensliste der Reise Ungarn 2026"
      ],
      "expect": {
        "proposes": "trip_people",
        "argument": {
          "name": "email",
          "equals": "viktoria@example.test"
        },
        "answerHasNot": [
          "welche adresse",
          "brauche noch",
          "wie lautet"
        ]
      }
    },
    {
      "id": "card-to-trip-vague",
