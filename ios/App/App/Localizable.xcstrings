    "routeActivity.stopConfirm.title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnung der Route „%@“ stoppen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop recording the %@ route?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter l’enregistrement de l’itinéraire « %@ » ?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leállítod a(z) „%@” útvonal rögzítését?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompere la registrazione del percorso “%@”?"
          }
        }
      },
      "comment": "B2733 — %@ is the armed trip's own title."
    },
    "routeActivity.stopConfirm.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld nicht gesendete Positionen sind auf dem Telefon. Sie werden jetzt noch einmal gesendet; schlägt das fehl, bleiben sie erhalten und werden beim nächsten Mal gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld unsent positions are on the phone. They are sent once more now; if that fails they are kept and sent next time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld positions non envoyées se trouvent sur le téléphone. Elles seront renvoyées maintenant ; en cas d’échec, elles seront conservées et envoyées la prochaine fois."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld el nem küldött pozíció van a telefonon. Most újra megpróbáljuk elküldeni őket; ha ez nem sikerül, megmaradnak, és legközelebb elküldjük."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld posizioni non inviate sono sul telefono. Verranno inviate di nuovo ora; se non riesce, resteranno e verranno inviate la prossima volta."
          }
        }
      },
      "comment": "B2733 — %lld is the count of positions still on the phone (buffer plus any pending final upload)."
    },
    "routeActivity.stopConfirm.stop": {
      "localizations": {
