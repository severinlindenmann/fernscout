          "stringUnit": {
            "state": "translated",
            "value": "La localisation est réglée sur « Lors de l’utilisation ». L’enregistrement s’arrête à la fermeture de l’appli. Touchez pour corriger."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helymeghatározás „Alkalmazás használatakor” módban van. A rögzítés leáll, ha bezárod az appot. Koppints a javításhoz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La posizione è impostata su “Solo durante l'uso”. La registrazione si ferma quando chiudi l'app. Tocca per risolvere."
          }
        }
      },
      "comment": "B2733 — Live Activity needs-you card, permission downgraded to While Using."
    },
    "routeActivity.needsPermission.unauthorized": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden wurde abgelehnt. Positionen bleiben auf dem Telefon. Öffne die App, um dich erneut anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending refused. Positions stay on the phone. Open the app to sign in again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi refusé. Les positions restent sur le téléphone. Ouvrez l’appli pour vous reconnecter."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A küldés elutasítva. A pozíciók a telefonon maradnak. Nyisd meg az appot, hogy újra bejelentkezz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio rifiutato. Le posizioni restano sul telefono. Apri l'app per accedere di nuovo."
          }
        }
      },
      "comment": "B2733 — Live Activity needs-you card, uploads refused (401)."
    },
    "routeActivity.ended": {
