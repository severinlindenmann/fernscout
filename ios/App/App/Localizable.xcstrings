    "saveToInbox.remove.message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto wurde nie gesendet — es bleibt auf deinem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo was never sent — it stays on your phone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n'a jamais été envoyée — elle reste sur votre téléphone."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a fénykép sosem lett elküldve — a telefonodon marad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa foto non è mai stata inviata — resta sul tuo telefono."
          }
        }
      },
      "comment": "B2732"
    },
    "saveToInbox.remove.title": {
      "localizations": {
        "de": {
