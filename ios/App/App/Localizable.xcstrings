    "shareInbox.studio.line": {
      "comment": "B2195 — share sheet, start a new trip — closing card; %d is the photo count, plural. 'Bring in an old trip' is the studio's own menu entry (studio.hub.item.photos.title) and must match it in each language.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Fotos · laden im Hintergrund hoch, Originale bleiben erhalten. Öffne Fernscout → Eine alte Reise importieren, innerhalb von zwei Tagen, um sie aufzubauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d photographs · uploads in the background, originals intact. Open Fernscout → Bring in an old trip within two days to build it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d photos · envoi en arrière-plan, originaux intacts. Ouvre Fernscout → Importer un ancien voyage dans les deux jours pour le construire."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%d fénykép · háttérben töltődik fel, az eredetik megmaradnak. Két napon belül nyisd meg a Fernscoutot → Egy régi út behozása, és építsd fel az utat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%d foto · caricamento in background, originali intatti. Entro due giorni apri Fernscout → Importa un vecchio viaggio per costruirlo."
          }
        }
      }
    },
