<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- B2123. What the app itself collects, in Apple's vocabulary. The
	     reasoning behind each row is in the harness's docs/compliance/app-store-privacy.md
	     (B2317 added name, phone, address, other content, purchases;
	     B2322 audio);
	     change that file and this one together. Capacitor's own framework
	     ships its own manifest and is not repeated here. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
