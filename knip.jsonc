// What is here for nothing. `npm run unused`, and a CI job of the same name.
//
// The four checks in AGENTS.md all answer "does what is here work". None of
// them answers "is anything here for nothing", so a file that stops being
// imported keeps compiling, keeps passing, and keeps being read by the next
// person as though it mattered. The cost is not disk: this codebase is written
// to be read, with the reasoning in the comments, and a comment explaining why
// something is shaped the way it is — in a file nothing calls any more — is
// worse than no comment. B24.
//
// **Entry points are the whole configuration.** Almost nothing here is
// imported by name: routes and layouts are entered by Next, `instrumentation`
// and `proxy` by the server, `sw.js` by the browser, and everything in
// `scripts/` by a person typing. A tool that does not know that reports the
// application as dead code, which is how a check earns being ignored.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // The Next.js plugin already contributes `app/**/{page,layout,route,…}`,
  // `next.config.ts` and the middleware. These are the ones nothing infers.
  "entry": [
    // Started by the Node server, never imported.
    "instrumentation.ts",
    "proxy.ts",
    // Registered by the browser, from a string in the page.
    "public/sw.js",
    // CLIs. `npm run <name>` is the caller, and package.json is not an import
    // graph, so every one of these looks unreferenced from the inside.
    "scripts/*.{ts,mts,mjs}",
    // A skill's own tooling — run by an agent following the SKILL.md beside it.
    ".claude/skills/**/*.mjs",
    // The v2 contract, phase 0 (B1587): schemas written as the reviewable
    // spec before the routes that consume them exist. Remove this entry when
    // the first /api/v2 route imports from it.
    "lib/api/v2/schemas/index.ts",
    // Camera roll import (B1751): `manifest.ts`'s `DayRow` and
    // `expiry.ts`'s `WARN_AFTER_MS`/`WARNED_GRACE_MS` are read by later
    // tasks in the same plan (day grouping, the expiry sweep's own tests)
    // that do not exist yet. `paths.ts`, `store.ts` and `sweep.ts` came off
    // this list once Task 1.2's routes gave them real callers; remove these
    // two once a caller outside their own file uses those three exports.
    "lib/staging/manifest.ts",
    "lib/staging/expiry.ts",
    // The studio skeleton (B1824): the preview and decide steps, built and
    // exported ahead of the concrete flows (B1830 "Add a day", B1831 "Change
    // a day", etc.) that will render them. `WhatStep.tsx` and
    // `ComingSoonFlow.tsx` already have a real caller — the studio hub's stub
    // routes — and are not on this list. Remove each file below once a flow
    // outside `components/studio/` imports it.
    "components/studio/PreviewNotice.tsx",
    "components/studio/DecideList.tsx",
    // Camera roll import (B1803): the tile, the strip and the viewer, built
    // and tested in Task 1.2 ahead of Task 1.3's screens — the day board, the
    // upload grid, the question screens — that render them. `PhotoTile.tsx`
    // came off this list on its own once `PhotoStrip.tsx` and
    // `PhotoViewer.tsx` imported it; remove these two once a screen outside
    // `components/extract/` imports either of them.
    "components/extract/PhotoStrip.tsx",
    "components/extract/PhotoViewer.tsx",
    // Open core: the WhatsApp message types are imported by paid/ (its own
    // repository, outside knip's graph) and by the stub that stands in for it,
    // so from inside this repository nothing seems to use them.
    "lib/whatsappTypes.ts",
    // The suite, and the fixtures it reaches for.
    "test/**/*.test.{ts,tsx}",
    "test/fixtures/**/*.{ts,tsx}",
    "vitest.config.mts",
    // Each migration is imported as a namespace and handed to Kysely whole
    // (`lib/db/migrations/index.ts`), which never names `up` or `down`. They
    // are entered by the migration runner, and nothing can see that statically.
    "lib/db/migrations/[0-9]*.ts",
    // Route recording (B2204): `mintGpsToken` is the client half of the
    // `write:gps` token, built ahead of the Swift wiring (B2196/B2198) that
    // will call it from the studio's recording toggle. Every other export in
    // this file already has a real caller and is not why it is here. Remove
    // this entry once something outside `nativeShell.ts` imports
    // `mintGpsToken`.
    "components/nativeShell.ts"
  ],

  "ignore": [
    // Other sessions' checkouts. They are whole copies of this repository
    // living inside it, and scanning them reports every file several times
    // over — the same reason eslint.config.mjs ignores `.claude/**`.
    ".claude/worktrees/**",
    // A plan's own scratch workspace: briefs, reports, captures and the
    // one-off scripts written to check a single branch. Tracked so a review
    // can read them, never imported by the application.
    ".superpowers/**",
    // A person's journals, and generated derivatives of them. Not code.
    "content/**",
    // Generated: the packed place index and the world map are built by
    // scripts/build-*.mjs and read as data.
    "lib/data/**"
  ],

  // External programs, checked for at run time and absent by design on a
  // machine that has not installed them. `lib/capabilities.ts` is the thing
  // that decides whether each is available; a missing one switches a feature
  // off rather than breaking it, so none of them belongs in package.json.
  // Open core: dependencies only paid/ imports (written by open-core/split).
  // They stay in package.json, so one lockfile serves both builds.
  "ignoreDependencies": ["d3-geo","stripe"],

  "ignoreBinaries": [
    // macOS's own memory report, read by scripts/slot.mjs to hold heavy work
    // back while the machine is short of memory. Part of the OS, not a package.
    "vm_stat",
    // poppler, for uniting the variant-lab's comparison sheets into one
    // catalogue and for rasterising the pages `variant-shots.mts` proofs.
    // Lab-only; nothing the product ships calls either.
    "pdfunite",
    "pdftoppm",
    // Ghostscript, which the production server has and a laptop may not:
    // the print preview rasterises the checked print file with it when it
    // is on PATH and embeds the PDF otherwise (B2006). Probed at runtime,
    // never required.
    "gs",
    "caddy",
    "ffmpeg",
    "ffprobe",
    "restic",
    "pg_restore",
    "openssl",
    "systemd-analyze",
    // macOS-only tools scripts/fetch-demo-photos.mjs shells out to.
    "sips",
    "exiftool"
  ],

  // Two severities, and the split is the point.
  //
  // **Error** is everything that must stay at zero: a whole file nothing
  // reaches, a dependency nothing imports, an import of something that is not
  // declared — and, since B235 cleared the 153 that had accumulated, an
  // `export` on a symbol nothing outside its own file uses. Each of those is a
  // fact about the repository, and each fails CI the day it becomes true.
  //
  // **Warn** is left for the shapes B235 did not touch — a namespace export,
  // an unused member of an exported enum, a declaration duplicated across
  // files — which are real findings but not this ticket's.
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "error",
    "types": "error",
    "nsExports": "warn",
    "nsTypes": "warn",
    "enumMembers": "warn",
    "duplicates": "warn"
  }
}
