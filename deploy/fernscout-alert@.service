# Somebody is told how %i ended.
#
#   OnFailure=fernscout-alert@%n.service
#   OnSuccess=fernscout-alert@%n.service
#
# on any unit that matters. systemd passes the failing unit's full name
# (including the .service suffix) as the instance, so %i below is
# "fernscout-backup.service" and nothing has to be hardcoded here.
#
# Installed by scripts/deploy.sh, like every unit in this folder (B138) — it
# used to say "copy this by hand", and the hand-copy is exactly what did not
# happen on the server that then went two days without an alert handler.
#
#   sudo systemctl start fernscout-alert@fernscout-backup.service   # rehearse it
#
# Not enabled, and has no timer: it is started by systemd when %i ends, only.
# It cannot be enabled by bare name anyway — a template needs an instance.
[Unit]
Description=Report how %i ended
# The mail leaves this box, so do not race the network on a boot-time failure.
After=network-online.target

[Service]
Type=oneshot
User=fernscout
Group=fernscout
WorkingDirectory=/srv/fernscout
EnvironmentFile=/etc/fernscout/env
ExecStart=/srv/fernscout/scripts/alert.sh %i
# An alarm that hangs is an alarm nobody hears. Short on purpose.
TimeoutStartSec=2min

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Writes the failure stamp under DATA_DIR, and nothing else.
ReadWritePaths=/srv/fernscout /var/lib/fernscout
# Reading `journalctl -u` needs this; without it the alert still goes out, with
# "no journal was readable" in place of the last 25 lines.
SupplementaryGroups=systemd-journal

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fernscout-alert
