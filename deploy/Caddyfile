# A reference snippet, not a file to copy blindly.
#
# On a VPS that serves nothing else, this can become /etc/caddy/Caddyfile
# outright. On a machine that already has one — another site, another
# service — **merge the site block below into the existing file instead**.
# `sudo cp deploy/Caddyfile /etc/caddy/Caddyfile` would delete whatever was
# already there, and Caddy is a single-config-file server: there is only one
# of them, and everything on the machine shares it.
#
# Automatic HTTPS: Caddy requests and renews a Let's Encrypt certificate for
# {$CADDY_DOMAIN} on first request, with no cron job and no certbot. Needs
# :80 reachable for the ACME HTTP-01 challenge and :443 for the site itself —
# Caddy binds both itself; nothing else may hold :80 or :443.
#
# {$CADDY_DOMAIN} / {$CADDY_ACME_EMAIL} come from the environment (.env);
# see .env.example. For a bare local/offline test, run with
# CADDY_DOMAIN=:80 to skip TLS entirely (see docs/runbook.md) — Caddy detects
# the plain :80/:8080-style address and serves HTTP-only automatically.
#
# The global options block (rather than a per-site `tls <email>`) keeps this
# working for any CADDY_DOMAIN, TLS or not. `email` needs a non-empty
# argument — set a real address here before the first certificate request
# so this never sees a blank one, even before .env exists.
#
# Merging into an existing Caddyfile: take the site block only. A second
# global options block is a config error, and adding one where there was none
# changes ACME behaviour for the sites already being served.
{
	email {$CADDY_ACME_EMAIL}
}

{$CADDY_DOMAIN} {
	encode gzip zstd

	# Next.js sets its own cache headers per-route (see next.config.ts and
	# the API routes' `cache-control: no-store`); Caddy just proxies. The app
	# runs on this host — there is no container to address by name.
	reverse_proxy 127.0.0.1:3000 {
		# Overwrite, never append — and this line is load-bearing.
		#
		# Caddy's default is to *append* the real client address to whatever
		# `X-Forwarded-For` arrived. `clientIp()` in lib/rateLimit.ts reads the
		# first value, so without this a client that sends its own
		# `X-Forwarded-For: 203.0.113.9` is rate-limited as 203.0.113.9 —
		# rotate the header per request and every limit on this server resets.
		# That includes the eight-guess limit in front of a trip's password.
		#
		# The app trusts the first value *because* of this line. If Caddy is
		# ever replaced, the replacement has to overwrite the header too, or
		# `clientIp()` has to stop trusting it. See B01.
		header_up X-Forwarded-For {remote_host}
	}
}
