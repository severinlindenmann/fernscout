    "whatsapp": {
      "enabled": false,
      "backend": "dry-run",
      "defaultCountryCode": "41",
      "templates": {
        "de": "fernscout_day_published_v2",
        "en": "fernscout_day_published_v2",
        "hu": "fernscout_day_published_v2"
      }
    },
    "auth": {
      "enabled": false
    },
    "signup": {
      "enabled": false
