{
  "configVersion": 1,
  "site": {
    "name": "Fernscout",
    "url": "https://fernscout.ch",
    "defaultUser": "example",
    "repository": "https://github.com/severinlindenmann/fernscout",
    "banner": {
      "enabled": true,
      "text": "Beta – Testphase: Einige Funktionen sind noch unvollständig, und Datenverlust ist nicht auszuschliessen.",
      "translations": {
        "de": "Beta – Testphase: Einige Funktionen sind noch unvollständig, und Datenverlust ist nicht auszuschliessen.",
        "en": "Beta – testing phase: some features are still incomplete, and data loss cannot be ruled out.",
        "hu": "Béta – tesztidőszak: egyes funkciók még nem teljesek, és az adatvesztés sem zárható ki."
      }
    },
    "credit": {
      "name": "Severin Lindenmann",
      "url": "https://severin.io",
      "countryCode": "CH"
    }
  },
  "users": {
    "reserved": [
      "api",
      "agent",
      "media",
      "_next",
      "static",
      "admin",
      "trips",
      "day",
      "costs",
      "gallery",
      "map",
      "welcome",
      "i",
      "join",
      "auth",
      "legal",
      "docs",
      "documentation",
      "llms",
      "openapi",
      "sitemap",
      "robots",
      "manifest",
      "icon",
      "apple-icon",
      "opengraph-image",
      "favicon"
